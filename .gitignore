# Environment / secrets
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# Data — real MIMIC-IV data must NEVER be committed (credentialed access only)
data/
!data/.gitkeep
*.csv
*.csv.gz
*.parquet
*.db
*.sqlite

# Large or sensitive data (org-wide patterns): store these outside Git unless sharing is permitted
*.bam
*.cram
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.vcf
*.vcf.gz
*.h5ad
*.h5

