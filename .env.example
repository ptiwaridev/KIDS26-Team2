# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# During dev, most teammates should set USE_SYNTHETIC_DATA=true and point
# at a local/synthetic-seeded Azure SQL + Azure AI Search instance. Only
# credentialed team members should ever set this to false against real
# MIMIC-IV-backed resources.
USE_SYNTHETIC_DATA=true

# --- One-time provisioning only — read by scripts/provision_azure.sh, NOT by ---
# --- the app. Leave blank here; set real values only in your local .env.    ---
SQL_ADMIN_USER=sqladmin
SQL_ADMIN_PASSWORD=

# --- Azure SQL (structured data: patients, admissions, diagnoses_icd, labevents, prescriptions) ---
# AZURE_SQL_USERNAME/PASSWORD below should be the low-privilege login created
# by scripts/create_readonly_login.py (`make readonly-login`) — never the
# admin login above.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=mimic_subset
AZURE_SQL_USERNAME=your-readonly-username
AZURE_SQL_PASSWORD=your-password
# Full ODBC connection string alternative (overrides the discrete vars above if set)
AZURE_SQL_CONNECTION_STRING=

# --- Azure AI Search (RAG over discharge summaries + radiology reports) ---
# AZURE_SEARCH_API_KEY: read-only query key (az search query-key create) —
# this is what the app and teammates use, safe to share.
# AZURE_SEARCH_ADMIN_KEY: can write/manage the index — ingestion scripts
# only (create_search_index.py, ingest_notes.py), never share this one.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-query-key
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=clinical-notes

# --- Azure AI Foundry (embeddings + generation) ---
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-api-key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_CHAT_DEPLOYMENT=claude-sonnet-5

# --- App ---
STREAMLIT_SERVER_PORT=8501
LOG_LEVEL=INFO
